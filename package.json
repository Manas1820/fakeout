{
  "name": "fakeout",
  "version": "1.0.67",
  "description": "Detect disposable email domains — zero dependencies, auto-updated dataset",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-domains": "tsx scripts/sync-domains.ts"
  },
  "keywords": [
    "disposable",
    "email",
    "temporary",
    "burner",
    "validation",
    "domain",
    "blocklist"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manas1820/fakeout.git"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.0",
    "semantic-release": "^24.0.0"
  },
  "pnpm": {
    "overrides": {
      "@semantic-release/npm": "^13.1.0"
    }
  }
}
